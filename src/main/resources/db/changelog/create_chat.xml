<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">


    <changeSet author="xvnns" id="tbl_chat" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not> <tableExists tableName="chat" /> </not>
        </preConditions>
        <createTable tableName="chat">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="is_private" type="bool">
                <constraints nullable="false"/>
            </column>
            <column name="user_id_creator" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="xvnns" id="uk_chat_1" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not> <indexExists indexName="uk_chat_1" /> </not>
        </preConditions>
        <addUniqueConstraint
                constraintName="uk_chat_1"
                tableName="chat"
                columnNames="name"/>
    </changeSet>
    <changeSet author="xvnns" id="fk_chat_1" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not> <foreignKeyConstraintExists foreignKeyName="fk_chat_1" /> </not>
        </preConditions>
        <addForeignKeyConstraint constraintName="fk_chat_1"
                                 baseTableName="chat"
                                 baseColumnNames="user_id_creator"
                                 referencedTableName="user"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>